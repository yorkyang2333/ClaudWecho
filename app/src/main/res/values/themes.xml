<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash Screen Theme using androidx.core:core-splashscreen -->
    <style name="Theme.ClaudWecho.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ClaudWecho</item>
    </style>

    <style name="Theme.ClaudWecho" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowSwipeToDismiss">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>